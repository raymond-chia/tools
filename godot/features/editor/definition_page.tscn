[gd_scene format=3]

[ext_resource type="Script" path="res://features/editor/definition_page.gd" id="1"]

[node name="DefinitionPage" type="HSplitContainer"]
script = ExtResource("1")
split_offset = 340

[node name="ListPanel" type="VBoxContainer" parent="."]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2

[node name="Title" type="Label" parent="ListPanel"]
layout_mode = 2

[node name="Entries" type="ItemList" parent="ListPanel"]
layout_mode = 2
