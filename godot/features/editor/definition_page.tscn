[node name="Duplicate" type="Button" parent="ListPanel/Actions"]
layout_mode = 2
text = "複製"

[node name="Remove" type="Button" parent="ListPanel/Actions"]
layout_mode = 2
text = "刪除"

[node name="FormPanel" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="Scroll" type="ScrollContainer" parent="FormPanel"]
layout_mode = 2
size_flags_vertical = 3

[node name="Fields" type="GridContainer" parent="FormPanel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
columns = 2

[node name="AddDialog" type="ConfirmationDialog" parent="."]
title = "新增資料"
initial_position = 2
ok_button_text = "新增"
cancel_button_text = "取消"
dialog_hide_on_ok = false

[node name="Form" type="VBoxContainer" parent="AddDialog"]

[node name="Label" type="Label" parent="AddDialog/Form"]
layout_mode = 2
