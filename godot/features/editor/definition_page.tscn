[node name="Error" type="Label" parent="AddDialog/Form"]
layout_mode = 2
autowrap_mode = 2

[node name="RemoveDialog" type="ConfirmationDialog" parent="."]
title = "刪除資料"
initial_position = 2
ok_button_text = "刪除"
cancel_button_text = "取消"

[node name="RemoveErrorDialog" type="AcceptDialog" parent="."]
title = "無法刪除"
